# ══════════════════════════════════════════════════════════════════════════════
# Job-Search AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.
#
# Good news: everything below has a sensible default. You can run the app with
# an empty .env. Only touch these if you want to change the defaults.
# ══════════════════════════════════════════════════════════════════════════════

# ── Hardware & model (auto-detected — leave blank unless overriding) ──────────
# The app runs nvidia-smi on startup and picks a model for your hardware:
#   cpu        -> phi4-mini:q4_K_M     (no GPU)
#   gpu_avg    -> phi4:q4_K_M          (GPU < 10 GB VRAM)
#   gpu_modern -> gemma2:9b            (GPU >= 10 GB VRAM)
HARDWARE_TIER=                       # force a tier: cpu | gpu_avg | gpu_modern
AGENT_MODEL=                         # force an exact Ollama model (wins over tier)

# ── Reranker (sorts results by relevance) ────────────────────────────────────
RERANK_PASSES=2                      # 1 = fast | 2 = balanced (default) | 3 = best
RERANK_MODEL=ms-marco-MiniLM-L-12-v2 # set "none" to disable reranking

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434  # docker (use http://localhost:11434 for local dev)

# ── Vector store (ChromaDB embedded — no server, just a folder on disk) ───────
CHROMA_DB_PATH=data/chroma           # where the vector data lives
EMBED_MODEL=BAAI/bge-small-en-v1.5   # local embedding model (Sentence Transformers)

# ── Pipeline output / result counts ───────────────────────────────────────────
PIPELINE_XLSX=data/job_pipeline.xlsx
TOP_JOBS=25
TOP_RESUME_RECS=10
TOP_BLIND_SPOTS=5

# ── Email / SMTP (optional — the app works fine without this) ─────────────────
# Gmail: use an App Password (not your main password)
# Settings -> Google Account -> Security -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=p.w.devens@gmail.com

# ── Scheduler (weekly email summaries) ────────────────────────────────────────
ENABLE_SCHEDULER=true
SCHEDULER_TZ=America/New_York
SCHEDULER_CRON=0 8 * * 1-5            # Mon-Fri 8:00 AM ET

# ── Scheduled pipeline defaults (used when running headless) ──────────────────
SCHEDULED_ROLE=Data Engineer / AI Engineer with Python SQL and LLM experience
SCHEDULED_GEO=Washington DC
SCHEDULED_JOBS_PATH=                 # optional: path to jobs CSV to re-ingest each run
SCHEDULED_RESUME_PATH=               # optional: path to resume to re-ingest each run

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Limits ────────────────────────────────────────────────────────────────────
UPLOAD_RETENTION_HOURS=24            # auto-cleanup old uploads
