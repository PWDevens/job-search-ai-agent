# ══════════════════════════════════════════════════════════════════════════════
# Job-Search AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Ollama Data Path ─────────────────────────────────────────────────────────
# Optional: If you have existing Ollama models, set this to that directory
# Example: OLLAMA_DATA_PATH=E:/coding-resources
# Leave blank to download models automatically in ./ollama_data
OLLAMA_DATA_PATH=

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb        # docker service name (or "localhost" for local dev)
CHROMA_PORT=8000

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434   # docker (use http://localhost:11434 for local dev)
LLM_BACKEND=phi4_mini                # phi4_mini | llama3 | mistral | llama3_1b | tinyllama
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Embedding backend ─────────────────────────────────────────────────────────
# "ollama" = use Ollama nomic-embed-text (preferred, requires Ollama running)
# "sentence_transformers" = use all-MiniLM-L6-v2 locally (works without Ollama)
EMBED_BACKEND=ollama
ST_MODEL=all-MiniLM-L6-v2

# ── Pipeline output ───────────────────────────────────────────────────────────
PIPELINE_XLSX=data/job_pipeline.xlsx
TOP_JOBS=25
TOP_RESUME_RECS=10
TOP_BLIND_SPOTS=5

# ── Email / SMTP (optional — summaries work without this) ─────────────────────
# Gmail: use an App Password (not your main password)
# Settings → Google Account → Security → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=p.w.devens@gmail.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true
SCHEDULER_TZ=America/New_York
SCHEDULER_CRON=0 8 * * 1-5          # Mon-Fri 8:00 AM ET

# ── Scheduled pipeline defaults (used when running headless) ──────────────────
SCHEDULED_ROLE=Data Engineer / AI Engineer with Python SQL and LLM experience
SCHEDULED_GEO=Washington DC
SCHEDULED_JOBS_PATH=                 # optional: path to jobs CSV to re-ingest each run
SCHEDULED_RESUME_PATH=               # optional: path to resume to re-ingest each run

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Timeouts & Limits ─────────────────────────────────────────────────────────
CHROMA_TIMEOUT=10                    # seconds (prevents hangs)
UPLOAD_RETENTION_HOURS=24            # auto-cleanup old uploads
