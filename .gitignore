chroma_data/
data/chroma/
data/.chroma_test/

# SQLite audit DB (generated at runtime)
data/audit.db

# SSH keys — never commit
RUNPOD-SSH.txt

# Pod-specific scripts (contain RunPod WebSocket credentials)
scripts/pod_*.py
RUNPOD-SSH.txt.pub

# Claude Code session files
.claude/
.pipeline/

# Generated reports / eval output
reports/

# Old docs archive
docs/archive/

# Ollama model cache (if running without Docker)
.ollama/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs (app.log, errors.log, rotating backups)
logs/
*.log

# Jupyter (keep notebooks but ignore checkpoints)
.ipynb_checkpoints/

