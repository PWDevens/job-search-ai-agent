*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Environment / secrets — NEVER commit these
.env
*.env.local

# Secrets folder (RunPod connection, SSH keys, any credentials)
.secrets/

# Data / uploads (user-specific, potentially sensitive)
data/uploads/
data/job_pipeline.xlsx
data/*.xlsx

